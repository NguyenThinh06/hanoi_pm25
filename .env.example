# Only needed to fetch new source data. Existing marts/models need neither key.
OPENAQ_API_KEY=
GEE_PROJECT=

# PostgreSQL/PostGIS local handover database
POSTGRES_DB=hanoi_pm25
POSTGRES_USER=hanoi_pm25
POSTGRES_PASSWORD=MAT_KHAU
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hanoi_pm25:MAT_KHAU@localhost:5432/hanoi_pm25

# Backend: React development origins; override with deployment origins.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Per-process dates/grids cache TTL in seconds; 0 disables caching.
API_CACHE_TTL_SECONDS=300
