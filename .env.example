# ==============================================================================
# HANOI_PM25 ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database PostgreSQL / PostGIS
POSTGRES_DB=hanoi_pm25
POSTGRES_USER=hanoi_pm25
POSTGRES_PASSWORD=hanoi_pm25_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hanoi_pm25:hanoi_pm25_secret@localhost:5432/hanoi_pm25

# Backend FastAPI Service
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
API_CACHE_TTL_SECONDS=300

# Frontend React Dashboard (Nginx Reverse Proxy)
FRONTEND_PORT=80

# Source credentials (chỉ dùng khi cần tải dữ liệu thô mới, không cần cho serving)
OPENAQ_API_KEY=
GEE_PROJECT=
